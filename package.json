{
  "name": "react-dragd",
  "version": "1.0.3",
  "description": "Drag-and-drop page builder and viewer for React.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "concurrently \"tsup --watch\" \"cd docs && npm run dev\"",
    "prepublishOnly": "npm run build"
  },
  "workspaces": [
    "docs"
  ],
  "author": "prnth.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/prnthh/react-dragd"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "react-colorful": "^5.6.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
